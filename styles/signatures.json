{
  "_note": "设计参数签名：让 40 个锚点的 token 层都能被 scripts/emit_tokens.py 确定性生成，而不是命中无 spec 的锚点时靠印象现编。有本地 spec 的锚点（diagonal / provisions-label / swiss-utility / museum-modern / warm-hospitality / editorial-print）以 spec 为准，本文件只补 spec 未给出的字阶 / 行高 / 字距 / 栅格。改本文件等于改设计，须附理由。",
  "_legend": {
    "r": "字阶比（模块化音阶的公比）。取族带内的值；改它等于改整套字号关系。",
    "base": "正文基准字号 px。移动端可减 1px，其余级随 r 等比缩放。",
    "lh": "正文行高倍数。CJK 主站取 1.7–1.95，拉丁为主可取 1.5–1.65。",
    "wrap": "主容器宽 px（映射为 --measure）。所有区块共用，不得各自为政。",
    "ch": "理想行长（字符数 ch）。正文列宽的目标值，不是容器宽。",
    "unit": "间距栅格基数 px。所有间距必须是它的整数倍。",
    "trk": "大标题字距 em。大字负字距、全大写正字距，正文 0。",
    "hue": "强调色相 OKLCH 角度（0–360）。0红 25橙砖 55赭金 130草绿 200青 250蓝 300品红。",
    "chr": "强调色彩度档：0 低（≤0.06，近中性）/ 1 中（≈0.12）/ 2 高（≈0.19）。",
    "warm": "色温：-1 冷 / 0 中性 / +1 暖。影响底色与灰阶的微倾。",
    "rad": "圆角 px。0 直角、2–4 近乎直角、8 柔和、16+ 有机。",
    "theme": "基调：light / dark。dark 时对比度与强调色亮度反向修正。",
    "mot": "动效性格：snap 快而干（120/200ms）/ soft 缓（180/320）/ drift 慢而长（300/600）/ none 零动效。",
    "wts": "允许的字重集，逗号分隔。一般 ≤2 个。",
    "disp": "标题字体角色：serif 衬线 / sans 无衬线 / mono 等宽 / mix 混排（衬线标题 + 无衬线正文）。",
    "surface": "底色档：white 纯白 / paper 纸白 / tint 有色底 / stone 中灰 / slate 石板 / ink 深底浅字 / deep 近黑。它决定 --bg 的明度与彩度，是「一批站看起来是不是同一套模板」最大的单一变量。锚点给的是**推荐档**，实际交付时可按批次账本的建议覆盖。",
    "variant": "尺度变体轴：a 原值 / b 收紧 / c 放松 / d 张扬。在同一锚点上做确定性的参数偏移（字阶比 / 基准字号 / 栅格基数 / 圆角 / 动效），使同一锚点第二次使用时不再逐值相同。"
  },
  "_surfacePresets": {
    "white": {
      "L": 1.0,
      "C": 0.0,
      "polarity": "light",
      "note": "纯白。最中性，也最容易撞 —— 同一批次里出现两次以上就该换档。"
    },
    "paper": {
      "L": 0.975,
      "C": 0.01,
      "polarity": "light",
      "note": "纸白。随 --warm 偏暖或偏冷，印刷气质，比纯白多一层呼吸。"
    },
    "tint": {
      "L": 0.945,
      "C": 0.026,
      "polarity": "light",
      "note": "有色底。底色本身参与表达，不再只是背景板。"
    },
    "stone": {
      "L": 0.9,
      "C": 0.014,
      "polarity": "light",
      "note": "中灰底。克制、降低眩光，适合长时间阅读与数据密集界面。"
    },
    "slate": {
      "L": 0.82,
      "C": 0.018,
      "polarity": "light",
      "note": "石板底。比 stone 更沉，接近深色但正文仍是深字，气质安静。"
    },
    "ink": {
      "L": 0.17,
      "C": 0.012,
      "polarity": "dark",
      "note": "深底浅字。戏剧性，适合展示型、终端型与夜间场景。"
    },
    "deep": {
      "L": 0.115,
      "C": 0.018,
      "polarity": "dark",
      "note": "近黑底。最强对比，适合奢华、夜场与高冲击展示。"
    }
  },
  "_variantAxes": {
    "a": {
      "label": "原值",
      "dr": 0.0,
      "dbase": 0,
      "dunit": 1.0,
      "drad": 0,
      "mot": null,
      "note": "锚点签名原样输出。第一次使用某锚点时默认取这条。"
    },
    "b": {
      "label": "收紧",
      "dr": -0.06,
      "dbase": -1,
      "dunit": 0.5,
      "drad": -2,
      "mot": "snap",
      "note": "更密、更小、更快 —— 信息型。适合台账、规格、索引。"
    },
    "c": {
      "label": "放松",
      "dr": 0.05,
      "dbase": 1,
      "dunit": 1.5,
      "drad": 3,
      "mot": "soft",
      "note": "更疏、更大、更慢 —— 呼吸型。适合叙事、作品集、品牌故事。"
    },
    "d": {
      "label": "张扬",
      "dr": 0.12,
      "dbase": 2,
      "dunit": 2.0,
      "drad": 8,
      "mot": "drift",
      "note": "尺度拉满 —— 宣言型。适合海报、开幕、单页强冲击。"
    }
  },
